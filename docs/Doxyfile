# ============================================
# Doxyfile для C# проекта "Домашняя библиотека"
# ============================================

# --- Проект ---
PROJECT_NAME           = "Домашняя библиотека"
OUTPUT_LANGUAGE        = Russian
DOXYFILE_ENCODING      = UTF-8

# --- Откуда брать код ---
INPUT                  = .
RECURSIVE              = YES
EXTENSION_MAPPING      = cs=C#

# --- Какие файлы искать ---
FILE_PATTERNS          = *.cs \
                         *.md

# --- Что игнорировать (ОЧЕНЬ ВАЖНО!) ---
EXCLUDE_PATTERNS       = */bin/* \
                         */obj/* \
                         */.git/* \
                         */.github/* \
                         */docs/* \
                         */Migrations/* \
                         */node_modules/*

# Явное исключение каталога вывода — чтобы Doxygen
# не индексировал собственный HTML при повторных сборках
EXCLUDE                = docs

# --- Куда сохранять результат ---
OUTPUT_DIRECTORY       = docs
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES

# --- Графы и диаграммы ---
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 100

# --- Поведение ---
EXTRACT_ALL            = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
CASE_SENSE_NAMES       = NO

# Контроль предупреждений (полезно, даже при EXTRACT_ALL = YES)
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
QUIET                  = NO

# --- Отключить лишние форматы (ускоряет сборку) ---
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO
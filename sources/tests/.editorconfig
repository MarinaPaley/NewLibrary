# Переопределение правил специально для папки с тестами
[*.cs]
csharp_style_var_elsewhere = true:suggestion
# CA1707: Identifiers should not contain underscores
dotnet_diagnostic.CA1707.severity = none 

# IDE0005: Using directive is unnecessary (включая проверку документации)
# dotnet_diagnostic.IDE0005.severity = none  # Missing XML comment